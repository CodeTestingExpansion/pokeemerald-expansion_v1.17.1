	setvar VAR_TEMP_2, 0
	goto_if_set FLAG_RECEIVED_REVIVED_FOSSIL_MON, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_AskToRegenerateAnotherFossil
	goto_if_set FLAG_REVIVED_HELIX, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_AskToRegenerateAnotherFossil
