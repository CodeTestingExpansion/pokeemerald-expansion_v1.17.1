	goto_if_eq VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_WHICH_FOSSIL, FOSSIL_ID_OLD_AMBER, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_MarkRevivedAmber
	goto CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_FossilMonReceived
	end

