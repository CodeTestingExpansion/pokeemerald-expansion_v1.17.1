CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_FossilMonReady::
	bufferspeciesname STR_VAR_1, VAR_TEMP_1
	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_FossilMonBackToLife
	givemon VAR_TEMP_1, 1
	goto_if_eq VAR_RESULT, 2, Common_EventScript_NoMoreRoomForPokemon
	goto_if_eq VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_WHICH_FOSSIL, FOSSIL_ID_HELIX, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_MarkRevivedHelix
